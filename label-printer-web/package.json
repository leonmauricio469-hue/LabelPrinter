{
  "name": "label-printer-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test/resolve-ts.mjs --test \"src/**/*.test.ts\"",
    "check:catalog": "node --import ./test/resolve-ts.mjs scripts/check-busqueda.ts && node --import ./test/resolve-ts.mjs scripts/check-barcode-plan.ts",
    "check": "npm run typecheck && npm test && npm run check:catalog",
    "preview": "node --import ./test/resolve-ts.mjs scripts/render-label.ts"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}