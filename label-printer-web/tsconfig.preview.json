{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".preview-build",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": [
    "scripts/**/*.ts",
    "src/lib/validation/schemas.ts",
    "src/lib/products/product.lookup.ts",
    "src/lib/labels/**/*.ts"
  ]
}